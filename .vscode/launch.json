{
    // the reruns and the timeout of pytest.ini would rerun a failed test and stop one that waits at a breakpoint; the module
    // is built before, so that the tests do not run with an old one
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pytest: current file",
            "presentation": { "group": "1-pytest", "order": 1 },
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "--reruns", "0", "--timeout", "0", "--no-cov"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "build: monero-python"
        },
        {
            "name": "pytest: unit tests",
            "presentation": { "group": "1-pytest", "order": 2 },
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-m", "unit", "--reruns", "0", "--timeout", "0", "--no-cov"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "build: monero-python"
        },
        {
            "name": "pytest: integration tests (docker)",
            "presentation": { "group": "1-pytest", "order": 3 },
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-m", "integration", "--reruns", "0", "--timeout", "0", "--no-cov"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "tests: build and setup docker"
        },
        {
            // the one of the Testing panel, when it debugs a test: it gives the test to run, so it is hidden from the list of Run and Debug
            "name": "pytest: debug test (Testing panel)",
            "type": "debugpy",
            "request": "launch",
            "purpose": ["debug-test"],
            "presentation": { "hidden": true },
            "env": { "PYTEST_ADDOPTS": "--reruns 0 --timeout 0 --no-cov" },
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "build: monero-python"
        },
        {
            // gdb starts python, so the breakpoints of src/cpp stop in the module of build-debug; it needs gdb (apt install gdb)
            "name": "C++: pytest current file (gdb)",
            "presentation": { "group": "2-cpp", "order": 1 },
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:python.interpreterPath}",
            "args": ["-m", "pytest", "${file}", "--reruns", "0", "--timeout", "0", "--no-cov"],
            "cwd": "${workspaceFolder}",
            "environment": [{ "name": "PYTHONPATH", "value": "${workspaceFolder}/build-debug" }],
            "MIMode": "gdb",
            "setupCommands": [
                { "description": "pretty printing of the types of the standard library", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "build: monero-python module (debug)"
        },
        {
            // gdb on a python that already runs, as one that waits at a breakpoint of debugpy: attaching to a process that gdb did
            // not start needs kernel.yama.ptrace_scope=0, or gdb as root
            "name": "C++: attach to a python process (gdb)",
            "presentation": { "group": "2-cpp", "order": 2 },
            "type": "cppdbg",
            "request": "attach",
            "program": "${command:python.interpreterPath}",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                { "description": "pretty printing of the types of the standard library", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "python: current file",
            "presentation": { "group": "3-python", "order": 1 },
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "env": { "PYTHONPATH": "${workspaceFolder}/build" },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            // the site, built strict as in CI and served with the reload at every change, with the mkdocs of the .venv of "setup: venv";
            // the browser opens on it once it is served, and a breakpoint in griffe_overloads.py or griffe_rst_links.py stops there
            "name": "docs: build and serve",
            "presentation": { "group": "4-docs", "order": 1 },
            "type": "debugpy",
            "request": "launch",
            "module": "mkdocs",
            "args": ["serve", "--strict"],
            "cwd": "${workspaceFolder}/docs/mkdocs",
            "console": "integratedTerminal",
            "justMyCode": false,
            "serverReadyAction": {
                "pattern": "Serving on (https?://[^\\s\\u001b]+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}
