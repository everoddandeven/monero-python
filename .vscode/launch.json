{
    // the reruns and the timeout of pytest.ini would rerun a failed test and stop one that waits at a breakpoint; the module
    // is built before, so that the tests do not run with an old one
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "--reruns", "0", "--timeout", "0", "--no-cov"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "build: monero-python module"
        },
        {
            "name": "pytest: unit tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-m", "unit", "--reruns", "0", "--timeout", "0", "--no-cov"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "build: monero-python module"
        },
        {
            "name": "pytest: integration tests (docker)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-m", "integration", "--reruns", "0", "--timeout", "0", "--no-cov"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "tests: build and start docker environment"
        },
        {
            // the one of the Testing panel, when it debugs a test
            "name": "pytest: debug test (Testing panel)",
            "type": "debugpy",
            "request": "launch",
            "purpose": ["debug-test"],
            "env": { "PYTEST_ADDOPTS": "--reruns 0 --timeout 0 --no-cov" },
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "build: monero-python module"
        },
        {
            // gdb starts python, so the breakpoints of src/cpp stop in the module of build-debug; it needs gdb (apt install gdb)
            "name": "C++: pytest current file (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:python.interpreterPath}",
            "args": ["-m", "pytest", "${file}", "--reruns", "0", "--timeout", "0", "--no-cov"],
            "cwd": "${workspaceFolder}",
            "environment": [{ "name": "PYTHONPATH", "value": "${workspaceFolder}/build-debug" }],
            "MIMode": "gdb",
            "setupCommands": [
                { "description": "pretty printing of the types of the standard library", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "build: monero-python module (debug)"
        },
        {
            // gdb on a python that already runs, as one that waits at a breakpoint of debugpy: attaching to a process that gdb did
            // not start needs kernel.yama.ptrace_scope=0, or gdb as root
            "name": "C++: attach to a python process (gdb)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${command:python.interpreterPath}",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                { "description": "pretty printing of the types of the standard library", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "python: current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "env": { "PYTHONPATH": "${workspaceFolder}/build" },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
