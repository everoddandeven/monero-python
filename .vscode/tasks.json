{
    "version": "2.0.0",
    "tasks": [
        {
            // the packages of apt of the build, on Ubuntu and Debian; sudo asks the password in the terminal of the task
            "label": "setup: system dependencies",
            "type": "shell",
            "command": "./bin/install_dependencies_linux.sh",
            "problemMatcher": []
        },
        {
            // the virtual environment of the README, with the versions that CI builds, tests and makes the docs with: the type checker
            // reads docs/mkdocs/griffe_overloads.py too, which imports griffe
            "label": "setup: venv",
            "type": "shell",
            "command": "./bin/setup_venv.sh",
            "problemMatcher": []
        },
        {
            // monero-project and monero-cpp, once and after an update of the submodules; JOBS=3 because a compiler of monero
            // takes up to 1.5 GB of memory
            "label": "build: monero-cpp",
            "type": "shell",
            "command": "./bin/build_monero_cpp.sh",
            "options": { "env": { "JOBS": "3" } },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build: monero-python",
            "detail": "build monero-python",
            "type": "shell",
            "command": "cmake -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -Dpybind11_DIR=\"$(python3 -m pybind11 --cmakedir)\" && cmake --build build -j3",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "options": {
                "statusbar": {
                    "hide": false,
                    "label": "Build",
                    "detail": "build monero-python",
                    "icon": { "id": "gear" },
                    // while it runs, a spinning icon
                    "running": { "icon": { "id": "sync~spin" } }
                }
            }
        },
        {
            // the module with the symbols and no optimization, for the debugger of C++, in a folder of its own
            "label": "build: monero-python module (debug)",
            "type": "shell",
            "command": "cmake -B build-debug -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -Dpybind11_DIR=\"$(python3 -m pybind11 --cmakedir)\" && cmake --build build-debug -j3",
            "problemMatcher": ["$gcc"]
        },
        {
            // monero-cpp again, optimized but with the symbols, so the debugger steps into it too; the module links it at the next
            // build. The type stays in the cache of that build, also for bin/build_monero_cpp.sh: -DCMAKE_BUILD_TYPE= goes back
            "label": "build: monero-cpp with debug info",
            "type": "shell",
            "command": "cmake -S external/monero-cpp -B external/monero-cpp/build -DCMAKE_BUILD_TYPE=RelWithDebInfo && cmake --build external/monero-cpp/build -j3",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "tests: unit",
            "type": "shell",
            "command": "${command:python.interpreterPath} -m pytest -m unit",
            "options": {
                "env": { "PYTHONPATH": "${workspaceFolder}/build" },
                "statusbar": { "hide": true, "label": "$(beaker) unit tests", "detail": "run monero-python unit tests" }
            },
            "group": "test",
            // each test that fails is an error of Problems, in the counter of the status bar
            "problemMatcher": {
                "owner": "pytest",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "severity": "error",
                "pattern": { "regexp": "^(?:FAILED|ERROR) ([^\\s:]+\\.py)::(.+)$", "file": 1, "message": 2 }
            }
        },
        {
            // as in CI, the coverage of the python of the tests; Coverage Gutters shows coverage.xml in the editor
            "label": "tests: unit (coverage)",
            "type": "shell",
            "command": "${command:python.interpreterPath} -m pytest -m unit --cov=tests --cov-report=xml:coverage.xml --cov-report=term:skip-covered",
            "options": { "env": { "PYTHONPATH": "${workspaceFolder}/build" } },
            "group": "test",
            // each test that fails is an error of Problems, in the counter of the status bar
            "problemMatcher": {
                "owner": "pytest",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "severity": "error",
                "pattern": { "regexp": "^(?:FAILED|ERROR) ([^\\s:]+\\.py)::(.+)$", "file": 1, "message": 2 }
            }
        },
        {
            // what the integration tests need: the module, and the network of docker; the launch configuration of the integration tests
            // runs it before them
            "label": "tests: build and setup docker",
            "dependsOn": ["build: monero-python", "tests: setup docker"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "tests: integration",
            "type": "shell",
            "command": "${command:python.interpreterPath} -m pytest -m integration",
            "dependsOn": ["tests: build and setup docker"],
            // each test that fails is an error of Problems, in the counter of the status bar
            "problemMatcher": {
                "owner": "pytest",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "severity": "error",
                "pattern": { "regexp": "^(?:FAILED|ERROR) ([^\\s:]+\\.py)::(.+)$", "file": 1, "message": 2 }
            },
            "options": {
                "env": { "PYTHONPATH": "${workspaceFolder}/build" },
                "statusbar": {
                    "hide": true,
                    "label": "Integration Tests",
                    "detail": "run monero-python integration tests",
                    "icon": { "id": "beaker" },
                    // while it runs, a spinning icon
                    "running": { "icon": { "id": "sync~spin" } }
                }
            }
        },
        {
            "label": "tests: setup docker",
            "type": "shell",
            "command": "docker compose -f tests/docker-compose.yml up -d node_1 node_2 xmr_wallet_1 xmr_wallet_2 xmr_wallet_3",
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": false,
                    "label": "Setup Docker",
                    "detail": "setup docker environment for integration tests",
                    "icon": { "id": "play" },
                    // while it runs, a spinning icon
                    "running": { "icon": { "id": "sync~spin" } }
                }
            }
        },
        {
            "label": "tests: stop docker",
            "type": "shell",
            "command": "docker compose -f tests/docker-compose.yml down -v",
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": false,
                    "label": "Stop Docker",
                    "detail": "stop the Docker environment for integration tests",
                    "icon": { "id": "stop-circle" },
                    // while it runs, a spinning icon
                    "running": { "icon": { "id": "sync~spin" } }
                }
            }
        },
        {
            // actionlint and zizmor, with the versions of .github/workflows/lint-workflows.yml
            "label": "lint: workflows",
            "type": "shell",
            "command": "./bin/lint_workflows.sh",
            "problemMatcher": []
        },
        {
            // codespell on the files of git, with the version of .github/workflows/spelling.yml
            "label": "lint: spelling",
            "type": "shell",
            "command": "./bin/check_spelling.sh",
            "problemMatcher": {
                "owner": "codespell",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": { "regexp": "^(.+):(\\d+): (.+)$", "file": 1, "line": 2, "message": 3 }
            }
        },
        {
            "label": "docs: serve",
            "type": "shell",
            "command": "./bin/docs.sh serve",
            "isBackground": true,
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": false,
                    "label": "$(book) Build Docs",
                    "detail": "Build and serve the docs at http://127.0.0.1:8000",
                    "running": { "label": "$(sync~spin) Docs at http://127.0.0.1:8000" }
                }
            }
        },
        {
            // lychee on the links to the web of the docs, the stubs and README.md, with the version of .github/workflows/links.yml
            "label": "lint: links",
            "type": "shell",
            "command": "./bin/check_links.sh",
            // each broken link is an error of Problems, at its line
            "problemMatcher": {
                "owner": "lychee",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "severity": "error",
                "pattern": [
                    { "regexp": "^\\[(.+)\\]:$", "file": 1 },
                    { "regexp": "^\\s+(\\[\\w+\\] \\S+) \\(at (\\d+):(\\d+)\\)", "message": 1, "line": 2, "column": 3, "loop": true }
                ]
            },
            "options": {
                "statusbar": {
                    "hide": false,
                    "label": "Lint Docs",
                    "detail": "Lint documentation links",
                    "icon": { "id": "checklist" },
                    // while it runs, a spinning icon
                    "running": { "icon": { "id": "sync~spin" } }
                }
            }
        },
        {
            // strict, as in CI
            "label": "docs: build",
            "type": "shell",
            "command": "./bin/docs.sh build",
            "problemMatcher": []
        }
    ]
}
