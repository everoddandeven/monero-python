{
    "version": "2.0.0",
    "tasks": [
        {
            // the packages of apt of the build, on Ubuntu and Debian; sudo asks the password in the terminal of the task
            "label": "setup: system dependencies",
            "type": "shell",
            "command": "./bin/install_dependencies_linux.sh",
            "problemMatcher": []
        },
        {
            // the virtual environment of the README, with the versions that CI builds, tests and makes the docs with: the type checker
            // reads docs/mkdocs/griffe_overloads.py too, which imports griffe
            "label": "setup: venv",
            "type": "shell",
            "command": "./bin/setup_venv.sh",
            "problemMatcher": []
        },
        {
            // monero-project and monero-cpp, once and after an update of the submodules.
            // The builds run MONERO_JOBS compilers at once, 3 by default because one of monero takes up to 1.5 GB of memory, and at a
            // low priority (nice), so the machine stays usable. On Windows, where these commands are not, they are the plain ones
            "label": "build: monero-cpp",
            "type": "shell",
            "command": "JOBS=\"$(printenv MONERO_JOBS | grep . || echo 3)\" nice -n 19 ./bin/build_monero_cpp.sh",
            "windows": { "command": "./bin/build_monero_cpp.sh" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build: monero-python",
            "detail": "build monero-python",
            "type": "shell",
            "command": "cmake -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -Dpybind11_DIR=\"$(python3 -m pybind11 --cmakedir)\" && nice -n 19 cmake --build build -j\"$(printenv MONERO_JOBS | grep . || echo 3)\"",
            "windows": { "command": "cmake -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -Dpybind11_DIR=\"$(python3 -m pybind11 --cmakedir)\" && cmake --build build -j3" },
            "group": { "kind": "build", "isDefault": true },
            // its button of the status bar, as the other ones, is of .vscode/extensions/status-bar-buttons
            "problemMatcher": ["$gcc"]
        },
        {
            // the module with the symbols and no optimization, for the debugger of C++, in a folder of its own
            "label": "build: monero-python module (debug)",
            "type": "shell",
            "command": "cmake -B build-debug -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -Dpybind11_DIR=\"$(python3 -m pybind11 --cmakedir)\" && nice -n 19 cmake --build build-debug -j\"$(printenv MONERO_JOBS | grep . || echo 3)\"",
            "windows": { "command": "cmake -B build-debug -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -Dpybind11_DIR=\"$(python3 -m pybind11 --cmakedir)\" && cmake --build build-debug -j3" },
            "problemMatcher": ["$gcc"]
        },
        {
            // monero-cpp again, optimized but with the symbols, so the debugger steps into it too; the module links it at the next
            // build. The type stays in the cache of that build, also for bin/build_monero_cpp.sh: -DCMAKE_BUILD_TYPE= goes back
            "label": "build: monero-cpp with debug info",
            "type": "shell",
            "command": "cmake -S external/monero-cpp -B external/monero-cpp/build -DCMAKE_BUILD_TYPE=RelWithDebInfo && nice -n 19 cmake --build external/monero-cpp/build -j\"$(printenv MONERO_JOBS | grep . || echo 3)\"",
            "windows": { "command": "cmake -S external/monero-cpp -B external/monero-cpp/build -DCMAKE_BUILD_TYPE=RelWithDebInfo && cmake --build external/monero-cpp/build -j3" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "tests: unit",
            "type": "shell",
            "command": "${command:python.interpreterPath} -m pytest -m unit",
            "options": {
                "env": { "PYTHONPATH": "${workspaceFolder}/build" },
                "statusbar": { "hide": true, "label": "$(beaker) unit tests", "detail": "run monero-python unit tests" }
            },
            "group": "test",
            // each test that fails is an error of Problems, in the counter of the status bar
            "problemMatcher": {
                "owner": "pytest",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "severity": "error",
                "pattern": { "regexp": "^(?:FAILED|ERROR) ([^\\s:]+\\.py)::(.+)$", "file": 1, "message": 2 }
            }
        },
        {
            // as in CI, the coverage of the python of the tests; Coverage Gutters shows coverage.xml in the editor
            "label": "tests: unit (coverage)",
            "type": "shell",
            "command": "${command:python.interpreterPath} -m pytest -m unit --cov=tests --cov-report=xml:coverage.xml --cov-report=term:skip-covered",
            "options": { "env": { "PYTHONPATH": "${workspaceFolder}/build" } },
            "group": "test",
            // each test that fails is an error of Problems, in the counter of the status bar
            "problemMatcher": {
                "owner": "pytest",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "severity": "error",
                "pattern": { "regexp": "^(?:FAILED|ERROR) ([^\\s:]+\\.py)::(.+)$", "file": 1, "message": 2 }
            }
        },
        {
            // what the integration tests need: the module, and the network of docker; the launch configuration of the integration tests
            // runs it before them
            "label": "tests: build and setup docker",
            "dependsOn": ["build: monero-python", "tests: setup docker"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "tests: integration",
            "type": "shell",
            "command": "${command:python.interpreterPath} -m pytest -m integration",
            "dependsOn": ["tests: build and setup docker"],
            // each test that fails is an error of Problems, in the counter of the status bar
            "problemMatcher": {
                "owner": "pytest",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "severity": "error",
                "pattern": { "regexp": "^(?:FAILED|ERROR) ([^\\s:]+\\.py)::(.+)$", "file": 1, "message": 2 }
            },
            "options": {
                "env": { "PYTHONPATH": "${workspaceFolder}/build" },
                "statusbar": {
                    "hide": true,
                    "label": "Integration Tests",
                    "detail": "run monero-python integration tests",
                    "icon": { "id": "beaker" },
                    // while it runs, a spinning icon
                    "running": { "icon": { "id": "sync~spin" } }
                }
            }
        },
        {
            // this and "tests: stop docker" share a button of the status bar, which shows one of the two by the state of docker: the
            // extension of .vscode/extensions/status-bar-buttons
            // the services of this command are the SERVICES of the button, in docker.js of that extension
            "label": "tests: setup docker",
            "type": "shell",
            "command": "docker compose -f tests/docker-compose.yml up -d node_1 node_2 xmr_wallet_1 xmr_wallet_2 xmr_wallet_3",
            "problemMatcher": []
        },
        {
            "label": "tests: stop docker",
            "type": "shell",
            "command": "docker compose -f tests/docker-compose.yml down -v",
            "problemMatcher": []
        },
        {
            // actionlint and zizmor, with the versions of .github/workflows/lint-workflows.yml
            "label": "lint: workflows",
            "type": "shell",
            "command": "./bin/lint_workflows.sh",
            // the links of zizmor in the names of its rules would be in the lines that the matcher reads
            "options": { "env": { "ZIZMOR_RENDER_LINKS": "never" } },
            // each finding is a problem of Problems, at its line
            "problemMatcher": [
                {
                    "owner": "actionlint",
                    "source": "actionlint",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "severity": "error",
                    "pattern": { "regexp": "^(\\.github/.+\\.ya?ml):(\\d+):(\\d+): (.+)$", "file": 1, "line": 2, "column": 3, "message": 4 }
                },
                {
                    "owner": "zizmor",
                    "source": "zizmor",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "severity": "info",
                    "pattern": [
                        { "regexp": "^(error|warning|info|help)\\[([^\\]]+)\\]: (.+)$", "severity": 1, "code": 2, "message": 3 },
                        { "regexp": "^\\s*--> (.+):(\\d+):(\\d+)$", "file": 1, "line": 2, "column": 3 }
                    ]
                }
            ]
        },
        {
            // codespell on the files of git, with the version of .github/workflows/spelling.yml
            "label": "lint: spelling",
            "type": "shell",
            "command": "./bin/check_spelling.sh",
            "problemMatcher": {
                "owner": "codespell",
                "source": "codespell",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": { "regexp": "^(.+):(\\d+): (.+)$", "file": 1, "line": 2, "message": 3 }
            }
        },
        {
            // the code of the docs and of README.md against the stubs, the first step of "docs: build"
            "label": "lint: examples",
            "type": "shell",
            "command": "./bin/docs.sh check",
            "problemMatcher": {
                "owner": "check_examples",
                "source": "check_examples",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+\\.md):(\\d+):(\\d+): (error|warning|information): (.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            // its button of the status bar, which stops it once the docs are served, is of .vscode/extensions/status-bar-buttons
            "label": "docs: serve",
            "type": "shell",
            "command": "./bin/docs.sh serve",
            "isBackground": true,
            // the warnings of mkdocs in Problems, again at every build of the site
            "problemMatcher": [
                {
                    "owner": "mkdocs",
                    "source": "mkdocs",
                    "severity": "warning",
                    "fileLocation": ["relative", "${workspaceFolder}/docs/mkdocs/docs"],
                    "pattern": {
                        "kind": "file",
                        "regexp": "^WARNING\\s+-\\s+(?:Doc file '|mkdocs_autorefs: )([^':]+\\.md)(?:'|:) (.+)$",
                        "file": 1,
                        "message": 2
                    },
                    "background": { "activeOnStart": true, "beginsPattern": "Building documentation", "endsPattern": "Documentation built in" }
                },
                {
                    "owner": "mkdocs-docstrings",
                    "source": "mkdocs",
                    "severity": "warning",
                    "fileLocation": "absolute",
                    "pattern": { "regexp": "^WARNING\\s+-\\s+griffe: (.+\\.pyi?):(\\d+): (.+)$", "file": 1, "line": 2, "message": 3 },
                    "background": { "activeOnStart": true, "beginsPattern": "Building documentation", "endsPattern": "Documentation built in" }
                }
            ]
        },
        {
            // lychee on the links to the web of the docs, the stubs and README.md, with the version of .github/workflows/links.yml
            "label": "lint: links",
            "type": "shell",
            // -vv shows where each redirect goes, and a line for each link too: grep leaves out the ones that were excluded, the ones
            // that are fine and the debug. tee keeps a copy of the output for the popups, and pipefail the exit code of the check
            "command": "set -o pipefail; mkdir -p .cache && ./bin/check_links.sh -vv 2>&1 | tee .cache/lint-links.log | grep -v -E '^\\[EXCLUDED\\]|^ *\\[DEBUG\\]|^ *\\[200\\] [^|]*$'",
            // each broken link is an error of Problems, at its line, and a popup of .vscode/extensions/status-bar-buttons, which finds
            // them by their "source"
            "problemMatcher": {
                "owner": "lychee",
                "source": "lychee",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "severity": "error",
                "pattern": [
                    { "regexp": "^\\[(.+)\\]:$", "file": 1 },
                    { "regexp": "^\\s*(\\[\\w+\\] \\S+) \\(at (\\d+):(\\d+)\\)", "message": 1, "line": 2, "column": 3, "loop": true }
                ]
            }
        },
        {
            // strict, as in CI
            "label": "docs: build",
            "type": "shell",
            "command": "./bin/docs.sh build",
            // in Problems, the errors of the code of the examples (bin/check_examples.py) and the warnings of mkdocs
            "problemMatcher": [
                {
                    "owner": "check_examples",
                    "source": "check_examples",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.+\\.md):(\\d+):(\\d+): (error|warning|information): (.+)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                },
                {
                    "owner": "mkdocs",
                    "source": "mkdocs",
                    "severity": "warning",
                    "fileLocation": ["relative", "${workspaceFolder}/docs/mkdocs/docs"],
                    "pattern": {
                        "kind": "file",
                        "regexp": "^WARNING\\s+-\\s+(?:Doc file '|mkdocs_autorefs: )([^':]+\\.md)(?:'|:) (.+)$",
                        "file": 1,
                        "message": 2
                    }
                },
                {
                    "owner": "mkdocs-docstrings",
                    "source": "mkdocs",
                    "severity": "warning",
                    "fileLocation": "absolute",
                    "pattern": { "regexp": "^WARNING\\s+-\\s+griffe: (.+\\.pyi?):(\\d+): (.+)$", "file": 1, "line": 2, "message": 3 }
                }
            ]
        }
    ]
}
